generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  decks          Deck[]
  quizzes        Quiz[]
  attempts       Attempt[]
  reviewLogs     ReviewLog[]
  generationLogs GenerationLog[]
  tags           Tag[]
}

model Deck {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  topic      String // short topic label, used for weak-topic grouping
  sourceText String // the notes/text this was generated from (truncated)
  flashcards Flashcard[]
  quiz       Quiz?
  tags       Tag[]
  createdAt  DateTime    @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  decks     Deck[]

  @@unique([userId, name])
}

model Flashcard {
  id       String @id @default(cuid())
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front    String
  back     String
  position Int

  // Spaced repetition state (simplified SM-2, see src/lib/spacedRepetition.ts).
  // New cards default to dueAt: now — immediately due for first review.
  easeFactor     Float       @default(2.5)
  intervalDays   Int         @default(0)
  repetitions    Int         @default(0)
  dueAt          DateTime    @default(now())
  lastReviewedAt DateTime?
  reviews        ReviewLog[]
}

// One row per flashcard grading — feeds spaced-repetition history and,
// together with Attempt.completedAt, the study-streak calculation.
model ReviewLog {
  id           String    @id @default(cuid())
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade        Int // 0=Again 1=Hard 2=Good 3=Easy
  intervalDays Int // resulting interval after this grading
  easeFactor   Float // resulting ease factor after this grading
  reviewedAt   DateTime  @default(now())

  @@index([userId, reviewedAt])
}

// One row per successful /api/generate call — used to enforce a rolling
// 24h per-user cap (see src/lib/rateLimit.ts) since Gemini usage costs
// real money and had no cap at all before.
model GenerationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Quiz {
  id        String     @id @default(cuid())
  deckId    String     @unique
  deck      Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  questions Question[]
  attempts  Attempt[]
  createdAt DateTime   @default(now())
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt        String
  choices       String // JSON-encoded string[]
  correctIndex  Int
  explanation   String
  position      Int

  answers AttemptAnswer[]
}

model Attempt {
  id           String          @id @default(cuid())
  quizId       String
  quiz         Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scorePercent Float
  completedAt  DateTime        @default(now())
  answers      AttemptAnswer[]
}

model AttemptAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIndex   Int
  correct       Boolean
}
