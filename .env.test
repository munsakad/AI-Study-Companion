# Separate SQLite file so `npm test` never touches your dev.db. Reset on
# every test run (see vitest.global-setup.ts).
DATABASE_URL="file:./test.db"

NEXTAUTH_SECRET="test-secret-not-for-real-use"
NEXTAUTH_URL="http://localhost:3000"
GEMINI_API_KEY="unused-in-tests-generateStudyMaterial-is-mocked"
GENERATION_DAILY_LIMIT="10"
