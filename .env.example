# SQLite for local dev — zero setup
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Max /api/generate calls per user per rolling 24h — it's the one route
# that costs real Gemini API usage per call.
GENERATION_DAILY_LIMIT="10"
